# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# Base de VisagShop con un usuario de SOLO LECTURA (ver "Base de datos de solo lectura" en el README).
DATABASE_URL=postgresql+pg8000://visagassist_lectura:CLAVE@HOST/BASE?sslmode=require

# Opcional: máximo de resultados por herramienta (1 a 50).
LIMITE_RESULTADOS=10

# Base PROPIA del asistente (historial y costos). Se prepara con: alembic upgrade head
DATABASE_URL_ASISTENTE=postgresql+pg8000://visagassist:CLAVE@HOST/visagassist?sslmode=require

# Clave de la API de Claude (la creas en console.anthropic.com). Nunca la subas a GitHub.
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-haiku-5-5

# Secreto compartido con VisagShop para firmar quién pregunta (mínimo 32 caracteres).
VISAGASSIST_SECRETO=
