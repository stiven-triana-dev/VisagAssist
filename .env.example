# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# Base de VisagShop con un usuario de SOLO LECTURA (ver "Base de datos de solo lectura" en el README).
DATABASE_URL=postgresql+pg8000://visagassist_lectura:CLAVE@HOST/BASE?sslmode=require

# Opcional: máximo de resultados por herramienta (1 a 50).
LIMITE_RESULTADOS=10
